<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/purple_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">


        <!-- CUSTOM TOOLBAR -->
        <LinearLayout
            android:id="@+id/customToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="88dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:background="@color/purple_dark">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EXCESS BAGGAGE CALCULATOR"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="72dp"
                android:text="SHARE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/purple_dark" />

        </LinearLayout>

        <!-- MAIN CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXCESS BAGGAGE"
                android:textColor="@color/purple_dark"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculate your excess baggage fees easily"
                android:textColor="#555555"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <!-- HELPFUL NOTICE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BAGGAGE ALLOWANCE\n\nEconomy Class: 20 kg\nBusiness Class: 40 kg\nService Tax: 8% on excess charge"
                android:textColor="@color/purple_dark"
                android:textSize="14sp"
                android:padding="16dp"
                android:background="@color/white"
                android:layout_marginBottom="20dp" />

            <!-- BAGGAGE WEIGHT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Baggage Weight (kg)"
                android:textColor="@color/purple_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter baggage weight"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:layout_marginBottom="18dp" />

            <!-- TICKET CLASS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ticket Class"
                android:textColor="@color/purple_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spTicketClass"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:backgroundTint="@color/purple_dark" />

            <!-- RATE PER KG -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Excess Baggage Rate (RM/kg)"
                android:textColor="@color/purple_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter rate per kg"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:layout_marginBottom="24dp" />

            <!-- CALCULATE BUTTON -->
            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="CALCULATE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/purple_dark" />

            <!-- RESULTS TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CALCULATION RESULTS"
                android:textColor="@color/purple_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp" />

            <!-- EXCESS WEIGHT -->
            <TextView
                android:id="@+id/tvExcessWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Excess Weight: 0.00 kg"
                android:textColor="#333333"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="@color/white"
                android:layout_marginBottom="8dp" />

            <!-- EXCESS CHARGE -->
            <TextView
                android:id="@+id/tvExcessCharge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Excess Charge: RM 0.00"
                android:textColor="#333333"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="@color/white"
                android:layout_marginBottom="8dp" />

            <!-- TOTAL PAYABLE -->
            <TextView
                android:id="@+id/tvTotalPayable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Payable: RM 0.00"
                android:textColor="@color/purple_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="16dp"
                android:background="@color/white"
                android:layout_marginBottom="24dp" />

            <!-- INSTRUCTIONS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INSTRUCTIONS\n\n1. Enter baggage weight in kilograms.\n2. Select Economy or Business class.\n3. Enter the excess baggage rate per kg.\n4. Tap CALCULATE to view the charges."
                android:textColor="#333333"
                android:textSize="14sp"
                android:padding="16dp"
                android:background="@color/white"
                android:layout_marginBottom="20dp" />

            <!-- ABOUT BUTTON -->
            <Button
                android:id="@+id/btnAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="ABOUT APPLICATION"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/purple_dark" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
